{
  "name": "merlin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0 <27",
    "pnpm": ">=12.14.0 <13"
  },
  "scripts": {
    "prepare": "node tools/prepare.mjs",
    "start": "pnpm build && dotnet run --project api/src/Merlin.Api --launch-profile https",
    "build": "pnpm --dir web build --mode server && node tools/copy-web.mjs",
    "build:debug": "pnpm build && dotnet build api/src/Merlin.Api",
    "lint": "pnpm --dir web lint",
    "typecheck": "pnpm --dir web typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "format:api": "dotnet format api/Merlin.slnx --verify-no-changes",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm test:hooks",
    "validate": "pnpm check && pnpm format:api && pnpm test:api && pnpm build",
    "test": "pnpm --dir web test",
    "test:hooks": "node --test .claude/hooks/",
    "test:api": "dotnet test --project api/tests/Merlin.Api.Tests --configuration Release",
    "package:app": "pnpm build && dotnet publish api/src/Merlin.Api --configuration Release --output artifacts/app",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "prettier": "3.9.10"
  },
  "lint-staged": {
    "web/**/*.{ts,tsx}": [
      "prettier --write",
      "pnpm --dir web exec eslint"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
